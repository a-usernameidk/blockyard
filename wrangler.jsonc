// Cloudflare settings for Blockyard. Cloudflare reads this file when it deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blockyard",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blockyard-db"
    }
  ],
  // Who gets the Admin button. Change it here, not in the dashboard.
  "vars": {
    "ADMIN_USERNAME": "SALT"
  },
  "observability": { "enabled": true }
}
